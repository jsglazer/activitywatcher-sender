{
  "name": "activitywatcher-sender",
  "version": "1.0.0",
  "description": "Zotero plugin that sends your current Zotero context (library-view collection, or the open item and its deepest collection) to ActivityWatch, so time in Zotero can be reported by collection.",
  "config": {
    "addonName": "ActivityWatcher Sender",
    "addonID": "activitywatcher-sender@jsglazer.com",
    "addonRef": "activitywatcher-sender",
    "addonInstance": "ActivityWatcherSender",
    "prefsPrefix": "extensions.activitywatcher-sender"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check . && eslint .",
    "release": "zotero-plugin release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsglazer/activitywatcher-sender.git"
  },
  "author": "Josh Glazer",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsglazer/activitywatcher-sender/issues"
  },
  "homepage": "https://github.com/jsglazer/activitywatcher-sender",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.1.1",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.0-beta.8"
  }
}
